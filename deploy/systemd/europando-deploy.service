[Unit]
Description=Pubblica Europando se su GitHub c'è una versione nuova
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
Group=deploy
ExecStart=/usr/local/bin/europando-deploy
# La costruzione del sito dura pochi secondi: se supera i dieci minuti
# qualcosa non sta andando e conviene fermarsi.
TimeoutStartSec=600
